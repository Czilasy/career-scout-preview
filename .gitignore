# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments and local env files
.venv/
venv/
env/
ENV/
.env

# Build and package artifacts
build/
dist/
*.egg-info/
.eggs/
*.egg

# Test and tool caches
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/
.tox/
.nox/

# Project-generated local files
docs/
debug.log
tests/regression_*.txt
tests/fixtures/discovery/*_result.json

# Local skill tooling config (baoyu-image-gen etc.)
.baoyu-skills/

# Workbuddy tool memory (per-machine state, not project code)
.workbuddy/

# Temporary diagnostic/scratch scripts
_tmp_*.py

# Editor and OS files
.idea/
.vscode/
.DS_Store
._*
Thumbs.db

