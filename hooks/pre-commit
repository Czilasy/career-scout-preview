#!/bin/sh
# 提交前自动运行仓库卫生测试，失败则阻断提交。
# 发布收口请复用 scripts/release_check.ps1；本钩子只做最小提交门禁。
# 启用：git config core.hooksPath hooks
set -e

echo "==> Repo hygiene check"
if ! uv run python -m unittest tests.test_repo_hygiene; then
    echo "!! Repo hygiene check failed. Fix the issues above, then commit again."
    exit 1
fi
echo "==> Repo hygiene check passed"

echo "==> Staged diff whitespace check"
if ! git diff --cached --check; then
    echo "!! Staged diff has whitespace errors. Fix them, then commit again."
    exit 1
fi
echo "==> Staged diff whitespace check passed"
